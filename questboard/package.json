{
  "name": "questboard",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.meowbounty.questboard",
    "productName": "QuestBoard",
    "directories": {
      "output": "../dist/QuestBoard",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": null
    }
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.0.0",
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/noto-serif-sc": "^5.0.0",
    "gsap": "^3.12.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
